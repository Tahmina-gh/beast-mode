# ---- Copy to .env and fill in. NEVER commit .env ----
APP_ENV=development            # development | production
AUTH_SECRET=change-me-to-a-long-random-string     # python -c "import secrets;print(secrets.token_hex(32))"
BASE_URL=http://127.0.0.1:5000
DATABASE_URL=sqlite:///instance/beast.db          # prod: postgresql://user:pass@host:5432/beast
GYM_NAME=BEAST MODE
CURRENCY=usd
REQUIRE_VERIFIED_EMAIL=1
CANCEL_CUTOFF_HOURS=2
COOKIE_SECURE=0                # set 1 when served over HTTPS
TRUST_PROXY=0                  # set 1 behind nginx/Heroku/Render

# ---- Payments (Stripe Checkout). Leave blank => "pay at front desk" mode ----
PAYMENT_SECRET=sk_test_xxx     # Stripe secret key
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ---- Email (any SMTP provider: Resend, SendGrid, Mailgun, Gmail app password...) ----
EMAIL_API_KEY=                 # SMTP password / API key
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=apikey
EMAIL_FROM=BEAST MODE <no-reply@yourgym.com>
ADMIN_NOTIFY_EMAIL=owner@yourgym.com

# ---- File storage (local disk by default) ----
UPLOAD_DIR=uploads
STORAGE_BACKEND=local          # architecture hook: swap for s3 in storage.py

# ---- Optional SMS / WhatsApp (Twilio) ----
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=                   # e.g. +15551234567 or whatsapp:+14155238886

# ---- First admin (used by: flask --app app create-admin) ----
ADMIN_EMAIL=admin@yourgym.com
ADMIN_PASSWORD=
